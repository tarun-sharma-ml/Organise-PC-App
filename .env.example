# Optional settings. Copy to .env (next to main.py when running from source,
# or %APPDATA%\Organise_PC\.env for the packaged .exe).

# AI-assisted renaming (free key from https://aistudio.google.com)
# GEMINI_API_KEY=your_gemini_api_key_here

# Approve AI rename suggestions from your phone via Telegram
# TELEGRAM_ENABLED=True
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_CHAT_ID=your_numeric_chat_id_here
